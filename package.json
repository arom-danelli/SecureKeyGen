{
  "name": "projeto-key",
  "version": "1.0.0",
  "description": "Conversor de Certificados PFX e CRT",
  "main": "index.js",
  "scripts": {
    "dev": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:linux": "electron-builder --linux",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac"
  },
  "keywords": [],
  "author": "Arom Danelli de Freitas",
  "license": "ISC",
  "devDependencies": {
    "electron": "^29.1.6",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "electron-log": "^5.1.5",
    "electron-store": "^9.0.0",
    "node-forge": "^1.3.1"
  },
  "build": {
    "appId": "aromdanelli.securekeygen",
    "productName": "Secure KeyGen",
    "files": [
      "src/**/*",
      "index.js",
      "package.json",
      "preload.js"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "src/assets/icons/icon.ico"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ],
      "category": "Utility",
      "icon": "src/assets/icons"
    },
    "mac": {
      "target": "dmg",
      "icon": "src/assets/icons/app-icon.icns"
    }
  }
}
